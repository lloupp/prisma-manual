# Supabase Postgres — local development and production share the same
# database (a dedicated Supabase project for this app). Get these from the
# Supabase dashboard: Project → Connect. Local dev now requires network access.

# Pooled connection (Supavisor, transaction mode, port 6543) — used by the
# app at runtime via the @prisma/adapter-pg driver adapter in lib/prisma.ts.
# pgbouncer=true disables Prisma's prepared statements, which Supavisor's
# transaction mode does not support.
DATABASE_URL="postgres://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Supavisor session mode, port 5432) — used only by the
# Prisma CLI (migrate dev, migrate deploy, db pull) via prisma.config.ts.
# Never used by the app at runtime.
DIRECT_URL="postgres://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# URL pública do site (usada por app/sitemap.ts e app/robots.ts).
# Opcional: em produção na Vercel, VERCEL_URL já cobre isso automaticamente.
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.com"
