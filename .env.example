# Local development (SQLite file)
DATABASE_URL="file:./dev.db"

# Production (Turso — descomente e preencha após criar o banco em turso.tech)
# Atenção: se TURSO_DATABASE_URL estiver definida (mesmo com um valor de exemplo),
# ela tem prioridade sobre DATABASE_URL em lib/prisma.ts. Mantenha as duas linhas
# abaixo comentadas para desenvolvimento local com SQLite.
# TURSO_DATABASE_URL="libsql://seu-banco-usuario.turso.io"
# TURSO_AUTH_TOKEN="seu-token-aqui"

# URL pública do site (usada por app/sitemap.ts e app/robots.ts).
# Opcional: em produção na Vercel, VERCEL_URL já cobre isso automaticamente.
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.com"
